APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=emergencias
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Central de Emergencias Chile ---

# Servicios geoespaciales autoalojados (ver docker-compose.yml).
OSRM_BASE_URL=http://127.0.0.1:5000
JUEGO_OSRM_VELOCIDAD_EXTRA_KMH=10
NOMINATIM_BASE_URL=http://127.0.0.1:8080

# Proveedor de teselas del mapa (plan gratuito).
VITE_MAPTILER_KEY=

# Parámetros de la simulación (ver config/juego.php).
JUEGO_CREDITOS_INICIALES=5000
JUEGO_RADIO_GENERACION_MISION_METROS=3000
JUEGO_TOPE_MISIONES_EXTRA_POR_JUGADOR=1
JUEGO_EDIFICIOS_MINIMOS_MISION_ESPECIAL=3
JUEGO_RECOMPENSA_MISION_MINIMA=250
JUEGO_RECOMPENSA_MISION_MAXIMA=500
JUEGO_TIEMPO_RESOLUCION_BASE_SEGUNDOS=180
JUEGO_DESCUENTO_TIEMPO_RESOLUCION_POR_UNIDAD_SEGUNDOS=20
JUEGO_TIEMPO_RESOLUCION_MINIMO_SEGUNDOS=30
JUEGO_ESTACIONAMIENTOS_MAXIMOS=15
JUEGO_COSTO_AMPLIACION_ESTACIONAMIENTO=1000
JUEGO_FACTOR_VELOCIDAD_TIEMPO=1

# Laravel Reverb (tiempo real).
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
